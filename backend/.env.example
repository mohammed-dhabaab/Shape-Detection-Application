# Copy to .env for local development. Values shown are the defaults
# (except LOG_FORMAT, which defaults to json for production).

# --- Service ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (structured, for production) | console (readable, for development)
LOG_FORMAT=console
# Comma-separated list. "*" is rejected at startup when ENVIRONMENT=production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Upload & resource limits ----------------------------------------------
MAX_FILE_SIZE_MB=10
MAX_IMAGE_WIDTH=7680
MAX_IMAGE_HEIGHT=7680
# Total pixel budget: guards memory and decompression bombs.
MAX_IMAGE_PIXELS=40000000
# CPU-bound detections allowed to run in parallel.
MAX_CONCURRENT_DETECTIONS=2

# --- Detection (OpenCV) ----------------------------------------------------
DETECTOR_BACKEND=opencv
# Images are analysed with their longest side at most this many pixels.
PROCESSING_MAX_DIMENSION=1600
# Smallest contour considered, in px² of the original image.
MIN_CONTOUR_AREA=500
# approxPolyDP tolerance as a fraction of the contour perimeter.
CONTOUR_APPROXIMATION_FACTOR=0.04
CANNY_LOW_THRESHOLD=30
CANNY_HIGH_THRESHOLD=100
CIRCLE_MIN_CIRCULARITY=0.8
CIRCLE_MIN_ENCLOSING_FILL=0.88
# How closely an outline must match its best-fit ellipse to count as round.
ELLIPSE_MIN_FIT=0.985
SQUARE_ASPECT_RATIO_TOLERANCE=0.1
MIN_SOLIDITY=0.9
MIN_DETECTION_SCORE=0.8
DUPLICATE_IOU_THRESHOLD=0.6
# Recombine shapes whose outlines cross (line drawings): widest separating line, in
# processing pixels. 0 disables.
REGION_MERGE_MAX_GAP=12

# --- Annotation ------------------------------------------------------------
ANNOTATED_IMAGE_MAX_DIMENSION=2048
ANNOTATED_IMAGE_QUALITY=85
